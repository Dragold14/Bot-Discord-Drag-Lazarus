# Ne partage JAMAIS ton token.
DISCORD_TOKEN=COLLE_ICI_LE_TOKEN_DU_BOT
CLIENT_ID=ID_DE_L_APPLICATION
GUILD_ID=ID_DE_TON_SERVEUR

# Salon où les demandes sont envoyées au staff
REQUEST_CHANNEL_ID=ID_DU_SALON_DEMANDES

# Rôle autorisé à accepter/refuser les demandes classiques
STAFF_ROLE_ID=ID_DU_ROLE_STAFF

# Optionnel : rôle spécifique autorisé à traiter les demandes Haut Commandement.
# Si vide, STAFF_ROLE_ID sera utilisé.
HC_STAFF_ROLE_ID=

# Rôles attribués automatiquement après acceptation
ROLE_PHYSIQUE_ID=ID_ROLE_FANTASSIN_PHYSIQUE
ROLE_PTOLEMEE_ID=ID_ROLE_OPERATEUR_PTOLEMEE
ROLE_RD_ID=ID_ROLE_RD
ROLE_HC_ID=ID_ROLE_HAUT_COMMANDEMENT

# Visuels du panneau (URL https directe). Laisse vide si tu n'en veux pas.
LOGO_URL=
BANNER_URL=
