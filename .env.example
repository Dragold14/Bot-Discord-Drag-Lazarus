# Staff : rôle des staff du serveur (donné via la demande "Rôle Staff").
STAFF_ROLE_ID=
# Officier d'Affectation : joueurs habilités à valider les demandes de rôles
# (accréditations, grades, spécialisations, R&D, Extra, demande particulière).
# Si vide, STAFF_ROLE_ID est utilisé à la place (ancien comportement).
AFFECTATION_ROLE_ID=
# La demande "Officier d'Affectation" du panneau (validée par le Superviseur)
# n'apparaît que si cette variable est renseignée.
# Superviseur d'Affectation (Directorat) : valide TOUTES les demandes, et seul
# à valider les demandes "Rôle Staff" et "Membre du Haut-Commandement".
# Si vide, seuls les administrateurs valident ces deux demandes.
HC_STAFF_ROLE_ID=

